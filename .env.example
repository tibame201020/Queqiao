PUBLIC_BASE_URL=https://your-public-host.example.com
PORT=7575
TRUST_PROXY_HOPS=1
OAUTH_APPROVAL_SECRET_FILE=C:\path\to\queqiao\data\secrets\oauth-approval-secret.secret
JWT_SIGNING_SECRET_FILE=C:\path\to\queqiao\data\secrets\jwt-signing-secret.secret
QUEQIAO_WORKER_URL=http://127.0.0.1:7576
