PUBLIC_BASE_URL=https://your-public-host.example.com
PORT=7575
TRUST_PROXY_HOPS=1
OAUTH_APPROVAL_SECRET=replace-with-a-long-random-secret
JWT_SIGNING_SECRET=replace-with-at-least-32-random-bytes
QUEQIAO_WORKER_URL=http://127.0.0.1:7576
QUEQIAO_WORKER_PORT=7576
QUEQIAO_WORKER_TOKEN=replace-with-a-long-random-worker-token
QUEQIAO_ENVIRONMENT_ID=windows
QUEQIAO_WORKSPACE_ID=default
QUEQIAO_WORKSPACE_ROOT=C:\path\to\workspace
QUEQIAO_WORKSPACES_FILE=C:\path\to\workspaces.json
QUEQIAO_WORKERS_FILE=C:\path\to\workers.json
