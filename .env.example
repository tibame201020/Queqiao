QUEQIAO_WORKER_TOKEN_FILE=C:\path\to\queqiao\data\secrets\worker-token.secret
QUEQIAO_ENVIRONMENT_ID=windows
QUEQIAO_WORKSPACE_ID=default
QUEQIAO_WORKSPACE_ROOT=C:\path\to\workspace
QUEQIAO_WORKSPACES_FILE=C:\path\to\workspaces.json
QUEQIAO_WORKERS_FILE=C:\path\to\workers.json
